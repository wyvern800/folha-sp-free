{
  "manifest_version": 3,
  "name": "folha-sp-free",
  "version": "1.0",
  "description": "Cansado de não conseguir ler as notícias do site folha-sp ? sua solução chegou!",
  "permissions": [
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www1.folha.uol.com.br/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "16x16.png",
    "48": "48x48.png",
    "128": "128x128.png"
  }
}