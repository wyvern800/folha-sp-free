{
  "manifest_version": 3,
  "name": "folha-sp-free",
  "version": "1.2",
  "description": "Cansado de não conseguir ler as notícias do site folha-sp? Sua solução chegou!",
  "permissions": [
    "tabs",
    "activeTab",
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www1.folha.uol.com.br/*",
        "https://f5.folha.uol.com.br/*",
        "*://www1.folha.uol.com.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "16x16.png",
    "48": "48x48.png",
    "128": "128x128.png"
  }
}
